apiVersion: tekton.dev/v1
kind: TaskRun
metadata:
  name: test-run
spec:
  taskRef:
    resolver: hub
    params:
      - name: type
        value: tekton
      - name: catalog
        value: Tekton
      - name: kind
        value: task
      - name: name
        value: git-clone
      - name: version
        value: "0.8"
