+// OPTIMIZATION: Batch process status updates
+func (c *Reconciler) batchUpdateStatuses(ctx context.Context, taskRuns []*v1.TaskRun) error {
+	// Group updates by namespace for efficiency
+	byNamespace := make(map[string][]*v1.TaskRun)
+	for _, tr := range taskRuns {
+		byNamespace[tr.Namespace] = append(byNamespace[tr.Namespace], tr)
+	}
+
+	var wg sync.WaitGroup
+	errChan := make(chan error, len(byNamespace))
+
+	for ns, trs := range byNamespace {
+		wg.Add(1)
+		go func(namespace string, runs []*v1.TaskRun) {
+			defer wg.Done()
+
+			for _, tr := range runs {
+				if err := c.updateStatus(ctx, tr); err != nil {
+					errChan <- err
+					return
+				}
+			}
+		}(ns, trs)
+	}
+
+	wg.Wait()
+	close(errChan)
+
+	// Collect any errors
+	for err := range errChan {
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
