@@ -44,8 +44,31 @@ func (tr *TaskRun) SupportedVerbs() []admissionregistrationv1.OperationType {
 	return []admissionregistrationv1.OperationType{admissionregistrationv1.Create, admissionregistrationv1.Update}
 }

+// OPTIMIZATION: Fast-path validation for common cases
+func (tr *TaskRun) FastValidate(ctx context.Context) *apis.FieldError {
+	// Quick checks for most common validation failures
+	if tr.Spec.TaskRef == nil && tr.Spec.TaskSpec == nil {
+		return apis.ErrMissingOneOf("taskRef", "taskSpec")
+	}
+	if tr.Spec.TaskRef != nil && tr.Spec.TaskSpec != nil {
+		return apis.ErrMultipleOneOf("taskRef", "taskSpec")
+	}
+
+	// For simple TaskRefs without complex features, skip full validation
+	if tr.Spec.TaskRef != nil &&
+	   tr.Spec.Debug == nil &&
+	   tr.Spec.StepSpecs == nil &&
+	   tr.Spec.SidecarSpecs == nil &&
+	   len(tr.Spec.Params) < 10 {
+		// Fast validation path
+		return nil
+	}
+
+	// Fall back to full validation for complex cases
+	return tr.Validate(ctx)
+}
+
 // Validate taskrun
 func (tr *TaskRun) Validate(ctx context.Context) *apis.FieldError {
 	errs := validate.ObjectMetadata(tr.GetObjectMeta()).ViaField("metadata")
 	return errs.Also(tr.Spec.Validate(apis.WithinSpec(ctx)).ViaField("spec"))
 }

