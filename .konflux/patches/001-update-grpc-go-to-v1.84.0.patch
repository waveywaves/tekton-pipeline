+func (op *Operation) wait(ctx context.Context, resp protoadapt.MessageV1, bo *gax.Backoff, sl sleeper, opts ...gax.CallOption) error {
+	for {
+		if err := op.Poll(ctx, resp, opts...); err != nil {
+			return err
+		}
+		if op.Done() {
+			return nil
+		}
+		if err := sl(ctx, bo.Pause()); err != nil {
+			return err
+		}
+	}
